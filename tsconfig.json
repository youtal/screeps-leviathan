{
  "compilerOptions": {
    "target": "es2019",
    "ignoreDeprecations": "5.0",
    "outDir": "dist/",
    "sourceMap": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@test/*": [
        "./test/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@setting/*": [
        "./src/setting/*"
      ]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "./src/",
    "./test/"
  ],
  "types":["screeps","node", "jest"]
}