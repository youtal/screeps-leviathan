{
  "compilerOptions": {
    "target": "es2017",
    "moduleResolution": "node",
    "outDir": "dist/",
    "sourceMap": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "allowUmdGlobalAccess": true,
    "types": ["screeps", "lodash", "node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@modules/*": ["./src/modules/*"],
      "@utils/*": ["./src/utils/*"],
      "@setting/*": ["./src/setting/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "exclude": ["node_modules"],
  "include": ["./src/", "./test/"]
}
