{
  "compilerOptions": {
    "target": "es2022",
    "outDir": "dist/",
    "sourceMap": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "moduleResolution": "node16",
    "ignoreDeprecations": "6.0",
    "types": [
      "screeps",
      "lodash",
      "node",
      "jest"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@test/*": [
        "./test/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@setting/*": [
        "./src/setting/*"
      ]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "./src/",
    "./test/"
  ]
}
